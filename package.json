{
  "name": "fluent-vue-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r --filter \"!./examples/*\" build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --filter \"!./examples/*\" typecheck",
    "examples:build": "pnpm -r --no-bail --filter \"./examples/*\" build",
    "examples:typecheck": "pnpm -r --no-bail --filter \"./examples/*\" typecheck",
    "lint": "eslint .",
    "ls-lint": "ls-lint",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@changesets/cli": "^3.0.3",
    "@changesets/get-github-info": "^1.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.ts?(x)": "eslint --fix",
    "*.md": "eslint --fix",
    "*.json": "eslint --fix",
    "*.yml": "eslint --fix"
  }
}
