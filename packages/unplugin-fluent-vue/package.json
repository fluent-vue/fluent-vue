{
  "name": "unplugin-fluent-vue",
  "type": "module",
  "version": "1.4.1",
  "description": "unplugin for fluent-vue. Adds support for custom blocks in Vue SFC and external ftl files.",
  "author": {
    "name": "Ivan Demchuk",
    "email": "ivan.demchuk@gmail.com",
    "url": "https://demivan.me"
  },
  "license": "MIT",
  "homepage": "https://fluent-vue.demivan.me/integrations/unplugin.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluent-vue/fluent-vue.git",
    "directory": "packages/unplugin-fluent-vue"
  },
  "keywords": [
    "unplugin",
    "vue",
    "fluent-vue",
    "ftl",
    "fluent",
    "webpack",
    "vite",
    "i18n",
    "plural"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.mts",
      "default": "./dist/rollup.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.mts",
      "default": "./dist/webpack.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "default": "./dist/nuxt.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "peerDependencies": {
    "@fluent/bundle": "*",
    "@nuxt/kit": "^3 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "dependencies": {
    "@fluent/syntax": "^0.19.0",
    "@rollup/pluginutils": "^5.0.0",
    "@vue/compiler-core": "^3.5.40",
    "magic-string": "^1.0.0",
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@fluent/bundle": "0.19.1",
    "@nuxt/kit": "4.7.0",
    "@nuxt/schema": "4.7.0",
    "@types/node": "26.6.11",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.2",
    "@vue/compiler-sfc": "3.5.46",
    "execa": "10.2.1",
    "memfs": "4.80.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "vue": "3.5.46",
    "vue-loader": "17.4.2",
    "webpack": "5.113.0"
  }
}
